# SSH target for the NAS, format "user@host"
NAS="user@hostname"
# SSH port for the initial master connection
NAS_PORT="22"
# Note: the persistent buildx builder "notizen-builder" is bound to NAS/NAS_PORT.
# If you change either, run `docker buildx rm notizen-builder` once so it rebinds —
# otherwise the deploy keeps building against the old endpoint.
# Docker image name/tag to build on the NAS and run via docker-compose
IMAGE="notizen"
# Absolute path on the NAS where docker-compose.yml and data live
REMOTE_DIR="/path/to/docker/notizen"
# Container name to recreate on the NAS
CONTAINER="notizen"
