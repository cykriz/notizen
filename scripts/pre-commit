#!/usr/bin/env bash
set -euo pipefail

echo "=== Pre-commit: lint ==="
bun run lint:check

# All three TS projects, not just the app: worker/ and e2e/ are excluded from the
# root tsconfig (own lib/types), so bare `tsc --noEmit` never sees them. A type
# error in the service worker went unnoticed for months that way.
echo "=== Pre-commit: typecheck (app + worker + e2e) ==="
bun run typecheck

echo "=== Pre-commit: unit tests ==="
bun test

# NOTE: E2E in pre-commit is intentional for now — ensures nothing ships broken.
# npx (not bunx): Playwright's test runner needs Node.js module loading internals
# for test.describe() globals — Bun's runtime doesn't support these hooks.
echo "=== Pre-commit: e2e tests ==="
npx playwright test --config e2e/playwright.config.ts

echo "=== All checks passed ==="
