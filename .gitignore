# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.test-notes-*
.test-todos-*
.test-trash-*
.test-settings-*
/test-results/
/e2e/test-results/
/e2e/playwright-report/
/e2e/blob-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
**/*.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# docker images
*.tar
*.tar.gz
*.tgz

# serwist service worker (build artifact)
/public/sw.js

# local data
/dev-notes
*.local.*

# editor / tooling
*.bak
.continue/

# keys & credentials (see SECURITY.md)
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
known_hosts
authorized_keys
.npmrc
.netrc

# auth data under NOTES_ROOT, in case NOTES_ROOT points inside the repo (replaces /e2e/.auth/)
**/.auth/

# design sources: carry editor metadata, kept out of the repo (see design/)
*.odg
