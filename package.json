{
  "name": "notizen",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "eslint --fix --fix-type suggestion,problem,layout .",
